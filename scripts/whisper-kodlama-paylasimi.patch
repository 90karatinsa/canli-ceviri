+    const bool use_kept_encoding = state->kept_audio_ctx >= 0 && state->kept_audio_ctx == params.audio_ctx && params.offset_ms == 0;
+    state->kept_audio_ctx = -1;
+
     if (n_samples > 0) {
         // compute log mel spectrogram
         if (whisper_pcm_to_mel_with_state(ctx, state, samples, n_samples, params.n_threads) != 0) {
@@ -7204,7 +7246,9 @@ int whisper_full_with_state(
