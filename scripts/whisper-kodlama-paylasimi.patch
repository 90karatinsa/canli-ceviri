+    int32_t kept_audio_ctx = -1;
+
     whisper_vad_context * vad_context = nullptr;
 
     struct vad_segment_info {
@@ -4247,6 +4250,41 @@ int whisper_lang_auto_detect(
     return whisper_lang_auto_detect_with_state(ctx, ctx->state, offset_ms, n_threads, lang_probs);
 }
 
+int whisper_lang_auto_detect_keep(
+        struct whisper_context * ctx,
+                   const float * samples,
+                           int   n_samples,
+                           int   audio_ctx,
+                           int   n_threads,
+                         float * lang_probs) {
+    whisper_state * state = ctx->state;
+    state->kept_audio_ctx = -1;
+
+    if (audio_ctx < 0 || audio_ctx > whisper_n_audio_ctx(ctx)) {
+        WHISPER_LOG_ERROR("%s: audio_ctx %d is out of range\n", __func__, audio_ctx);
+        return -5;
+    }
+    if (whisper_pcm_to_mel_with_state(ctx, state, samples, n_samples, n_threads) != 0) {
+        WHISPER_LOG_ERROR("%s: failed to compute mel spectrogram\n", __func__);
+        return -2;
+    }
+
+    state->exp_n_audio_ctx = audio_ctx;
+
+    const int lang_id = whisper_lang_auto_detect_internal(ctx, state, 0, n_threads, lang_probs, nullptr, nullptr);
+    if (lang_id >= 0) {
+        state->kept_audio_ctx = audio_ctx;
+    }
+
+    return lang_id;
+}
+
+void whisper_drop_kept_encoding(struct whisper_context * ctx) {
+    if (ctx->state) {
+        ctx->state->kept_audio_ctx = -1;
+    }
+}
+
 int whisper_model_n_vocab(struct whisper_context * ctx) {
     return ctx->model.hparams.n_vocab;
 }
